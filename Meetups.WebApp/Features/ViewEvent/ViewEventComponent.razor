

@page "/events/{id:int}"
@inject ViewEventService ViewEventService;
@inject LayoutService layoutService;

@if(_eventViewModel is not null)
{
    <h2>@_eventViewModel.Title</h2>
    <hr />

    <p>
        <img src="@_eventViewModel.ImageUrl" alt="Event Image" class="rounded"/>
    </p>

    <br />

    <h6>Details</h6>
    <pre style="white-space: pre-wrap; word-wrap: break-word">
        @_eventViewModel.Description
    </pre>
    
}



@code {

    [Parameter]
    public int id { get; set; }
    private EventViewModel _eventViewModel;

    protected override async Task OnParametersSetAsync()
    {
        var ev = await ViewEventService.GetEventByIdAsync(id);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            LayoutService.SetSectionContent(@<footer>
                <p class="mt-1 mb-0 card-text">Today</p>
                <p class="card-title fw-bold">Event title</p>
            </footer>);
        }
    }
}
