@page "/"

@inject ViewCreatedEventsService viewCreatedEventsService;

<h3>Created Events</h3

@if(_createdEvents is not null && _createdEvents.Count > 0)
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Begin Time</th>
                <th>End Time</th>
                <th>Capacity</th>
            </tr>
        </thead>
        <tbody>
            @foreach(var createdEvent in _createdEvents)
            {
                <tr>
                    <td style="text-align: center;">
                        <a href="/events/edit/@createdEvent.EventId">
                             @{
                                var eventImage = createdEvent.ImageUrl;
                                if(string.IsNullOrWhiteSpace(eventImage))
                                {
                                    eventImage = "/images/default-event.png";
                                }
                                <img src="@eventImage" alt="Event Image" class="img-thumbnail" style="width: 100px; height: 59px;" />
                            }
                            <br />
                            @createdEvent.Title
                        </a>
                    </td>
                    <td>@createdEvent.BeginDate.ToString("yyyy-MM-dd") @createdEvent.BeginTime.ToString(@"hh\:mm")</td>
                    <td>@createdEvent.EndDate.ToString("yyyy-MM-dd") @createdEvent.EndTime.ToString(@"hh\:mm")</td>
                    <td>
                        @{
                            if(createdEvent.Capacity == 0)
                            {
                                <text>Unlimited</text>;
                            }
                            else
                            {
                                <text>@createdEvent.Capacity</text>;
                            }
                            
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}


<a href="/events/create" class="btn btn-primary">Create New Meetup</a>

@code {
    private List<EventViewModel> _createdEvents = new List<EventViewModel>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            _createdEvents = await viewCreatedEventsService.GetEventsAsync();
            StateHasChanged();
        }
    }
}
